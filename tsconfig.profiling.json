{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* 🔥 Critical for flame graphs */
    "sourceMap": true,
    "inlineSources": true,

    /* Faster transpilation, less profiling noise */
    "incremental": false,
    "declaration": false,
    "declarationMap": false,

    /* Node-friendly output */
    "target": "ES2020",
    "module": "CommonJS",

    /* Cleaner stacks */
    "removeComments": false,

    "outDir": "./dist"
  },

  "include": ["performance/**/*.ts", "src/**/*.ts"],

  "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
